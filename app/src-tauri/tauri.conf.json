{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TPS View",
  "version": "0.1.1",
  "identifier": "io.github.tpsview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TPS View",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Landmark digitizer for TPS files",
    "longDescription": "Free, open-source app to create and edit .tps landmark files.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "tps",
          "TPS"
        ],
        "name": "TPS landmark file",
        "description": "TPS morphometrics landmark file",
        "role": "Editor"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
